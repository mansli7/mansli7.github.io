  "verses": [
    {
      "id": "hab-1-1",
      "chapter": 1,
      "verse": 1,
      "text": "先知哈巴谷所得的默示。"
    },
    {
      "id": "hab-2-1",
      "chapter": 2,
      "verse": 1,
      "text": "我要站在守望所，立在望樓上觀看，看耶和華對我說甚麼話，我可用甚麼話向他訴冤〔向他訴冤：或作回答所疑問的〕。"
    },
    {
      "id": "hab-3-1",
      "chapter": 3,
      "verse": 1,
      "text": "先知哈巴谷的禱告，調用流離歌。"
    }
  ]
}