{
  "book": "箴言",
  "book_id": "pro",
  "testament": "OT",
  "language": "zh",
  "version": "CUV",
  "verses": [
    {
      "id": "pro-1-1",
      "chapter": 1,
      "verse": 1,
      "text": "以色列王大衛兒子所羅門的箴言："
    },
    {
      "id": "pro-2-1",
      "chapter": 2,
      "verse": 1,
      "text": "我兒，你若領受我的言語，存記我的命令，"
    },
    {
      "id": "pro-3-1",
      "chapter": 3,
      "verse": 1,
      "text": "我兒，不要忘記我的法則〔或作：指教〕；你心要謹守我的誡命；"
    },
    {
      "id": "pro-4-1",
      "chapter": 4,
      "verse": 1,
      "text": "眾子啊，要聽父親的教訓，留心得知聰明。"
    },
    {
      "id": "pro-5-1",
      "chapter": 5,
      "verse": 1,
      "text": "我兒，要留心我智慧的話語，側耳聽我聰明的言詞，"
    },
    {
      "id": "pro-6-1",
      "chapter": 6,
      "verse": 1,
      "text": "我兒，你若為朋友作保，替外人擊掌，"
    },
    {
      "id": "pro-7-1",
      "chapter": 7,
      "verse": 1,
      "text": "我兒，你要遵守我的言語，將我的命令存記在心。"
    },
    {
      "id": "pro-8-1",
      "chapter": 8,
      "verse": 1,
      "text": "智慧豈不呼叫？聰明豈不發聲？"
    },
    {
      "id": "pro-9-1",
      "chapter": 9,
      "verse": 1,
      "text": "智慧建造房屋，鑿成七根柱子，"
    },
    {
      "id": "pro-10-1",
      "chapter": 10,
      "verse": 1,
      "text": "所羅門的箴言：智慧之子使父親歡樂；愚昧之子叫母親擔憂。"
    },
    {
      "id": "pro-11-1",
      "chapter": 11,
      "verse": 1,
      "text": "詭詐的天平為耶和華所憎惡；公平的法碼為他所喜悅。"
    },
    {
      "id": "pro-12-1",
      "chapter": 12,
      "verse": 1,
      "text": "喜愛管教的，就是喜愛知識；恨惡責備的，卻是畜類。"
    },
    {
      "id": "pro-13-1",
      "chapter": 13,
      "verse": 1,
      "text": "智慧子聽父親的教訓；褻慢人不聽責備。"
    },
    {
      "id": "pro-14-1",
      "chapter": 14,
      "verse": 1,
      "text": "智慧婦人建立家室；愚妄婦人親手拆毀。"
    },
    {
      "id": "pro-15-1",
      "chapter": 15,
      "verse": 1,
      "text": "回答柔和，使怒消退；言語暴戾，觸動怒氣。"
    },
    {
      "id": "pro-16-1",
      "chapter": 16,
      "verse": 1,
      "text": "心中的謀算在乎人；舌頭的應對由於耶和華。"
    },
    {
      "id": "pro-17-1",
      "chapter": 17,
      "verse": 1,
      "text": "設筵滿屋，大家相爭，不如有塊乾餅，大家相安。"
    },
    {
      "id": "pro-18-1",
      "chapter": 18,
      "verse": 1,
      "text": "與眾寡合的，獨自尋求心願，並惱恨一切真智慧。"
    },
    {
      "id": "pro-19-1",
      "chapter": 19,
      "verse": 1,
      "text": "行為純正的貧窮人勝過乖謬愚妄的富足人。"
    },
    {
      "id": "pro-20-1",
      "chapter": 20,
      "verse": 1,
      "text": "酒能使人褻慢，濃酒使人喧嚷；凡因酒錯誤的，就無智慧。"
    },
    {
      "id": "pro-21-1",
      "chapter": 21,
      "verse": 1,
      "text": "王的心在耶和華手中，好像隴溝的水隨意流轉。"
    },
    {
      "id": "pro-22-1",
      "chapter": 22,
      "verse": 1,
      "text": "美名勝過大財；恩寵強如金銀。"
    },
    {
      "id": "pro-23-1",
      "chapter": 23,
      "verse": 1,
      "text": "你若與官長坐席，要留意在你面前的是誰。"
    },
    {
      "id": "pro-24-1",
      "chapter": 24,
      "verse": 1,
      "text": "你不要嫉妒惡人，也不要起意與他們相處；"
    },
    {
      "id": "pro-25-1",
      "chapter": 25,
      "verse": 1,
      "text": "以下也是所羅門的箴言，是猶大王希西家的人所謄錄的。"
    },
    {
      "id": "pro-26-1",
      "chapter": 26,
      "verse": 1,
      "text": "夏天落雪，收割時下雨，都不相宜；愚昧人得尊榮也是如此。"
    },
    {
      "id": "pro-27-1",
      "chapter": 27,
      "verse": 1,
      "text": "不要為明日自誇，因為一日要生何事，你尚且不能知道。"
    },
    {
      "id": "pro-28-1",
      "chapter": 28,
      "verse": 1,
      "text": "惡人雖無人追趕也逃跑；義人卻膽壯像獅子。"
    },
    {
      "id": "pro-29-1",
      "chapter": 29,
      "verse": 1,
      "text": "人屢次受責罰，仍然硬着頸項；他必頃刻敗壞，無法可治。"
    },
    {
      "id": "pro-30-1",
      "chapter": 30,
      "verse": 1,
      "text": "雅基的兒子亞古珥的言語，就是真言。這人對以鐵和烏甲說："
    },
    {
      "id": "pro-31-1",
      "chapter": 31,
      "verse": 1,
      "text": "利慕伊勒王的言語，是他母親教訓他的真言。"
    }
  ]
}