  "language": "zh",
  "version": "CUV",
  "verses": [
    {
      "id": "jon-1-1",
      "chapter": 1,
      "verse": 1,
      "text": "耶和華的話臨到亞米太的兒子約拿，說："
    },
    {
      "id": "jon-2-1",
      "chapter": 2,
      "verse": 1,
      "text": "約拿在魚腹中禱告耶和華他的神，"
    },
    {
      "id": "jon-3-1",
      "chapter": 3,
      "verse": 1,
      "text": "耶和華的話二次臨到約拿說："
    },
    {
      "id": "jon-4-1",
      "chapter": 4,
      "verse": 1,
      "text": "這事約拿大大不悅，且甚發怒，"
    }
  ]
}