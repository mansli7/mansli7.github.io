{
  "book": "創世紀",
  "book_id": "gen",
  "testament": "OT",
  "language": "zh",
  "version": "CUV",
  "verses": [
    {
      "id": "gen-1-1",
      "chapter": 1,
      "verse": 1,
      "text": "起初神創造天地。"
    },
    {
      "id": "gen-2-1",
      "chapter": 2,
      "verse": 1,
      "text": "天地萬物都造齊了。"
    },
    {
      "id": "gen-3-1",
      "chapter": 3,
      "verse": 1,
      "text": "耶和華神所造的，惟有蛇比田野一切的活物更狡猾。蛇對女人說：「神豈是真說，不許你們吃園中所有樹上的果子嗎？」"
    },
    {
      "id": "gen-4-1",
      "chapter": 4,
      "verse": 1,
      "text": "有一日，那人和他妻子夏娃同房，夏娃就懷孕，生了該隱〔就是得的意思〕，便說：「耶和華使我得了一個男子。」"
    },
    {
      "id": "gen-5-1",
      "chapter": 5,
      "verse": 1,
      "text": "亞當的後代記在下面。（當神造人的日子，是照着自己的樣式造的，"
    },
    {
      "id": "gen-6-1",
      "chapter": 6,
      "verse": 1,
      "text": "當人在世上多起來、又生女兒的時候，"
    },
    {
      "id": "gen-7-1",
      "chapter": 7,
      "verse": 1,
      "text": "耶和華對挪亞說：「你和你的全家都要進入方舟；因為在這世代中，我見你在我面前是義人。"
    },
    {
      "id": "gen-8-1",
      "chapter": 8,
      "verse": 1,
      "text": "神記念挪亞和挪亞方舟裏的一切走獸牲畜。神叫風吹地，水勢漸落。"
    },
    {
      "id": "gen-9-1",
      "chapter": 9,
      "verse": 1,
      "text": "神賜福給挪亞和他的兒子，對他們說：「你們要生養眾多，遍滿了地。"
    },
    {
      "id": "gen-10-1",
      "chapter": 10,
      "verse": 1,
      "text": "挪亞的兒子閃、含、雅弗的後代記在下面。洪水以後，他們都生了兒子。"
    },
    {
      "id": "gen-11-1",
      "chapter": 11,
      "verse": 1,
      "text": "那時，天下人的口音、言語都是一樣。"
    },
    {
      "id": "gen-12-1",
      "chapter": 12,
      "verse": 1,
      "text": "耶和華對亞伯蘭說：「你要離開本地、本族、父家，往我所要指示你的地去。"
    },
    {
      "id": "gen-13-1",
      "chapter": 13,
      "verse": 1,
      "text": "亞伯蘭帶着他的妻子與羅得，並一切所有的，都從埃及上南地去。"
    },
    {
      "id": "gen-14-1",
      "chapter": 14,
      "verse": 1,
      "text": "當暗拉非作示拿王，亞略作以拉撒王，基大老瑪作以攔王，提達作戈印王的時候，"
    },
    {
      "id": "gen-15-1",
      "chapter": 15,
      "verse": 1,
      "text": "這事以後，耶和華在異象中有話對亞伯蘭說：「亞伯蘭，你不要懼怕！我是你的盾牌，必大大的賞賜你。」"
    },
    {
      "id": "gen-16-1",
      "chapter": 16,
      "verse": 1,
      "text": "亞伯蘭的妻子撒萊不給他生兒女。撒萊有一個使女，名叫夏甲，是埃及人。"
    },
    {
      "id": "gen-17-1",
      "chapter": 17,
      "verse": 1,
      "text": "亞伯蘭年九十九歲的時候，耶和華向他顯現，對他說：「我是全能的神。你當在我面前作完全人，"
    },
    {
      "id": "gen-18-1",
      "chapter": 18,
      "verse": 1,
      "text": "耶和華在幔利橡樹那裏向亞伯拉罕顯現出來。那時正熱，亞伯拉罕坐在帳棚門口，"
    },
    {
      "id": "gen-19-1",
      "chapter": 19,
      "verse": 1,
      "text": "那兩個天使晚上到了所多瑪；羅得正坐在所多瑪城門口，看見他們，就起來迎接，臉伏於地下拜，"
    },
    {
      "id": "gen-20-1",
      "chapter": 20,
      "verse": 1,
      "text": "亞伯拉罕從那裏向南地遷去，寄居在加低斯和書珥中間的基拉耳。"
    },
    {
      "id": "gen-21-1",
      "chapter": 21,
      "verse": 1,
      "text": "耶和華按着先前的話眷顧撒拉，便照他所說的給撒拉成就。"
    },
    {
      "id": "gen-22-1",
      "chapter": 22,
      "verse": 1,
      "text": "這些事以後，神要試驗亞伯拉罕，就呼叫他說：「亞伯拉罕！」他說：「我在這裏。」"
    },
    {
      "id": "gen-23-1",
      "chapter": 23,
      "verse": 1,
      "text": "撒拉享壽一百二十七歲，這是撒拉一生的歲數。"
    },
    {
      "id": "gen-24-1",
      "chapter": 24,
      "verse": 1,
      "text": "亞伯拉罕年紀老邁，向來在一切事上耶和華都賜福給他。"
    },
    {
      "id": "gen-25-1",
      "chapter": 25,
      "verse": 1,
      "text": "亞伯拉罕又娶了一妻，名叫基土拉。"
    },
    {
      "id": "gen-26-1",
      "chapter": 26,
      "verse": 1,
      "text": "在亞伯拉罕的日子，那地有一次饑荒；這時又有饑荒，以撒就往基拉耳去，到非利士人的王亞比米勒那裏。"
    },
    {
      "id": "gen-27-1",
      "chapter": 27,
      "verse": 1,
      "text": "以撒年老，眼睛昏花，不能看見，就叫了他大兒子以掃來，說：「我兒。」以掃說：「我在這裏。」"
    },
    {
      "id": "gen-28-1",
      "chapter": 28,
      "verse": 1,
      "text": "以撒叫了雅各來，給他祝福，並囑咐他說：「你不要娶迦南的女子為妻。"
    },
    {
      "id": "gen-29-1",
      "chapter": 29,
      "verse": 1,
      "text": "雅各起行，到了東方人之地，"
    },
    {
      "id": "gen-30-1",
      "chapter": 30,
      "verse": 1,
      "text": "拉結見自己不給雅各生子，就嫉妒她姊姊，對雅各說：「你給我孩子，不然我就死了。」"
    },
    {
      "id": "gen-31-1",
      "chapter": 31,
      "verse": 1,
      "text": "雅各聽見拉班的兒子們有話說：「雅各把我們父親所有的都奪了去，並藉着我們父親的，得了這一切的榮耀〔或作：財〕。」"
    },
    {
      "id": "gen-32-1",
      "chapter": 32,
      "verse": 1,
      "text": "雅各仍舊行路，神的使者遇見他。"
    },
    {
      "id": "gen-33-1",
      "chapter": 33,
      "verse": 1,
      "text": "雅各舉目觀看，見以掃來了，後頭跟着四百人，他就把孩子們分開交給利亞、拉結，和兩個使女，"
    },
    {
      "id": "gen-34-1",
      "chapter": 34,
      "verse": 1,
      "text": "利亞給雅各所生的女兒底拿出去，要見那地的女子們。"
    },
    {
      "id": "gen-35-1",
      "chapter": 35,
      "verse": 1,
      "text": "神對雅各說：「起來！上伯特利去，住在那裏；要在那裏築一座壇給神，就是你逃避你哥哥以掃的時候向你顯現的那位。」"
    },
    {
      "id": "gen-36-1",
      "chapter": 36,
      "verse": 1,
      "text": "以掃就是以東，他的後代記在下面。"
    },
    {
      "id": "gen-37-1",
      "chapter": 37,
      "verse": 1,
      "text": "雅各住在迦南地，就是他父親寄居的地。"
    },
    {
      "id": "gen-38-1",
      "chapter": 38,
      "verse": 1,
      "text": "那時，猶大離開他弟兄下去，到一個亞杜蘭人名叫希拉的家裏去。"
    },
    {
      "id": "gen-39-1",
      "chapter": 39,
      "verse": 1,
      "text": "約瑟被帶下埃及去。有一個埃及人，是法老的內臣護衛長波提乏，從那些帶下他來的以實瑪利人手下買了他去。"
    },
    {
      "id": "gen-40-1",
      "chapter": 40,
      "verse": 1,
      "text": "這事以後，埃及王的酒政和膳長得罪了他們的主埃及王，"
    },
    {
      "id": "gen-41-1",
      "chapter": 41,
      "verse": 1,
      "text": "過了兩年，法老作夢，夢見自己站在河邊，"
    },
    {
      "id": "gen-42-1",
      "chapter": 42,
      "verse": 1,
      "text": "雅各見埃及有糧，就對兒子們說：「你們為甚麼彼此觀望呢？"
    },
    {
      "id": "gen-43-1",
      "chapter": 43,
      "verse": 1,
      "text": "那地的饑荒甚大。"
    },
    {
      "id": "gen-44-1",
      "chapter": 44,
      "verse": 1,
      "text": "約瑟吩咐家宰說：「把糧食裝滿這些人的口袋，儘着他們的驢所能馱的，又把各人的銀子放在各人的口袋裏，"
    },
    {
      "id": "gen-45-1",
      "chapter": 45,
      "verse": 1,
      "text": "約瑟在左右站着的人面前情不自禁，吩咐一聲說：「人都要離開我出去！」約瑟和弟兄們相認的時候並沒有一人站在他面前。"
    },
    {
      "id": "gen-46-1",
      "chapter": 46,
      "verse": 1,
      "text": "以色列帶着一切所有的，起身來到別是巴，就獻祭給他父親以撒的神。"
    },
    {
      "id": "gen-47-1",
      "chapter": 47,
      "verse": 1,
      "text": "約瑟進去告訴法老說：「我的父親和我的弟兄帶着羊群牛群，並一切所有的，從迦南地來了，如今在歌珊地。」"
    },
    {
      "id": "gen-48-1",
      "chapter": 48,
      "verse": 1,
      "text": "這事以後，有人告訴約瑟說：「你的父親病了。」他就帶着兩個兒子瑪拿西和以法蓮同去。"
    },
    {
      "id": "gen-49-1",
      "chapter": 49,
      "verse": 1,
      "text": "雅各叫了他的兒子們來，說：「你們都來聚集，我好把你們日後必遇的事告訴你們。"
    },
    {
      "id": "gen-50-1",
      "chapter": 50,
      "verse": 1,
      "text": "約瑟伏在他父親的面上哀哭，與他親嘴。"
    }
  ]
}