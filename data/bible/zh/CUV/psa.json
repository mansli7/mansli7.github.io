{
  "book": "詩篇",
  "book_id": "psa",
  "testament": "OT",
  "language": "zh",
  "version": "CUV",
  "verses": [
    {
      "id": "psa-1-1",
      "chapter": 1,
      "verse": 1,
      "text": "不從惡人的計謀，不站罪人的道路，不坐褻慢人的座位，"
    },
    {
      "id": "psa-2-1",
      "chapter": 2,
      "verse": 1,
      "text": "外邦為甚麼爭鬧？萬民為甚麼謀算虛妄的事？"
    },
    {
      "id": "psa-3-1",
      "chapter": 3,
      "verse": 1,
      "text": "（大衛逃避他兒子押沙龍的時候作的詩）耶和華啊，我的敵人何其加增；有許多人起來攻擊我。"
    },
    {
      "id": "psa-4-1",
      "chapter": 4,
      "verse": 1,
      "text": "（大衛的詩，交與伶長。用絲絃的樂器）顯我為義的神啊，我呼籲的時候，求你應允我！我在困苦中，你曾使我寬廣；現在求你憐恤我，聽我的禱告！"
    },
    {
      "id": "psa-5-1",
      "chapter": 5,
      "verse": 1,
      "text": "（大衛的詩，交與伶長。用吹的樂器）耶和華啊，求你留心聽我的言語，顧念我的心思！"
    },
    {
      "id": "psa-6-1",
      "chapter": 6,
      "verse": 1,
      "text": "（大衛的詩，交與伶長。用絲絃的樂器，調用第八）耶和華啊，求你不要在怒中責備我，也不要在烈怒中懲罰我！"
    },
    {
      "id": "psa-7-1",
      "chapter": 7,
      "verse": 1,
      "text": "（大衛指着便雅憫人古實的話，向耶和華唱的流離歌）耶和華我的神啊，我投靠你！求你救我脫離一切追趕我的人，將我救拔出來！"
    },
    {
      "id": "psa-8-1",
      "chapter": 8,
      "verse": 1,
      "text": "（大衛的詩，交與伶長。用迦特樂器）耶和華我們的主啊，你的名在全地何其美！你將你的榮耀彰顯於天。"
    },
    {
      "id": "psa-9-1",
      "chapter": 9,
      "verse": 1,
      "text": "（大衛的詩，交與伶長。調用慕拉便）我要一心稱謝耶和華；我要傳揚你一切奇妙的作為。"
    },
    {
      "id": "psa-10-1",
      "chapter": 10,
      "verse": 1,
      "text": "耶和華啊，你為甚麼站在遠處？在患難的時候為甚麼隱藏？"
    },
    {
      "id": "psa-11-1",
      "chapter": 11,
      "verse": 1,
      "text": "（大衛的詩，交與伶長）我是投靠耶和華；你們怎麼對我說：你當像鳥飛往你的山去。"
    },
    {
      "id": "psa-12-1",
      "chapter": 12,
      "verse": 1,
      "text": "（大衛的詩，交與伶長。調用第八）耶和華啊，求你幫助，因虔誠人斷絕了；世人中間的忠信人沒有了。"
    },
    {
      "id": "psa-13-1",
      "chapter": 13,
      "verse": 1,
      "text": "（大衛的詩，交與伶長）耶和華啊，你忘記我要到幾時呢？要到永遠麼？你掩面不顧我要到幾時呢？"
    },
    {
      "id": "psa-14-1",
      "chapter": 14,
      "verse": 1,
      "text": "（大衛的詩，交與伶長）愚頑人心裏說：沒有神。他們都是邪惡，行了可憎惡的事；沒有一個人行善。"
    },
    {
      "id": "psa-15-1",
      "chapter": 15,
      "verse": 1,
      "text": "（大衛的詩）耶和華啊，誰能寄居你的帳幕？誰能住在你的聖山？"
    },
    {
      "id": "psa-16-1",
      "chapter": 16,
      "verse": 1,
      "text": "（大衛的金詩）神啊，求你保佑我，因為我投靠你。"
    },
    {
      "id": "psa-17-1",
      "chapter": 17,
      "verse": 1,
      "text": "（大衛的祈禱）耶和華啊，求你聽聞公義，側耳聽我的呼籲！求你留心聽我這不出於詭詐嘴唇的祈禱！"
    },
    {
      "id": "psa-18-1",
      "chapter": 18,
      "verse": 1,
      "text": "（耶和華的僕人大衛的詩，交與伶長。當耶和華救他脫離一切仇敵和掃羅之手的日子，他向耶和華念這詩的話，說：）耶和華，我的力量啊，我愛你！"
    },
    {
      "id": "psa-19-1",
      "chapter": 19,
      "verse": 1,
      "text": "（大衛的詩，交與伶長）諸天述說神的榮耀；穹蒼傳揚他的手段。"
    },
    {
      "id": "psa-20-1",
      "chapter": 20,
      "verse": 1,
      "text": "（大衛的詩，交與伶長）願耶和華在你遭難的日子應允你；願名為雅各神的高舉你。"
    },
    {
      "id": "psa-21-1",
      "chapter": 21,
      "verse": 1,
      "text": "（大衛的詩，交與伶長）耶和華啊，王必因你的能力歡喜；因你的救恩，他的快樂何其大！"
    },
    {
      "id": "psa-22-1",
      "chapter": 22,
      "verse": 1,
      "text": "（大衛的詩，交與伶長。調用朝鹿）我的神，我的神！為甚麼離棄我？為甚麼遠離不救我？不聽我唉哼的言語？"
    },
    {
      "id": "psa-23-1",
      "chapter": 23,
      "verse": 1,
      "text": "（大衛的詩）耶和華是我的牧者，我必不至缺乏。"
    },
    {
      "id": "psa-24-1",
      "chapter": 24,
      "verse": 1,
      "text": "（大衛的詩）地和其中所充滿的，世界和住在其間的，都屬耶和華。"
    },
    {
      "id": "psa-25-1",
      "chapter": 25,
      "verse": 1,
      "text": "（大衛的詩）耶和華啊，我的心仰望你。"
    },
    {
      "id": "psa-26-1",
      "chapter": 26,
      "verse": 1,
      "text": "（大衛的詩）耶和華啊，求你為我伸冤，因我向來行事純全；我又倚靠耶和華，並不搖動。"
    },
    {
      "id": "psa-27-1",
      "chapter": 27,
      "verse": 1,
      "text": "（大衛的詩）耶和華是我的亮光，是我的拯救，我還怕誰呢？耶和華是我性命的保障〔或作：力量〕，我還懼誰呢？"
    },
    {
      "id": "psa-28-1",
      "chapter": 28,
      "verse": 1,
      "text": "（大衛的詩）耶和華啊，我要求告你！我的磐石啊，不要向我緘默！倘若你向我閉口，我就如將死的人一樣。"
    },
    {
      "id": "psa-29-1",
      "chapter": 29,
      "verse": 1,
      "text": "（大衛的詩）神的眾子啊，你們要將榮耀、能力歸給耶和華，歸給耶和華！"
    },
    {
      "id": "psa-30-1",
      "chapter": 30,
      "verse": 1,
      "text": "（大衛在獻殿的時候，作這詩歌）耶和華啊，我要尊崇你，因為你曾提拔我，不叫仇敵向我誇耀。"
    },
    {
      "id": "psa-31-1",
      "chapter": 31,
      "verse": 1,
      "text": "（大衛的詩，交與伶長）耶和華啊，我投靠你；求你使我永不羞愧；憑你的公義搭救我！"
    },
    {
      "id": "psa-32-1",
      "chapter": 32,
      "verse": 1,
      "text": "（大衛的訓誨詩）得赦免其過、遮蓋其罪的，這人是有福的！"
    },
    {
      "id": "psa-33-1",
      "chapter": 33,
      "verse": 1,
      "text": "義人哪，你們應當靠耶和華歡樂；正直人的讚美是合宜的。"
    },
    {
      "id": "psa-34-1",
      "chapter": 34,
      "verse": 1,
      "text": "（大衛在亞比米勒面前裝瘋，被他趕出去，就作這詩）我要時時稱頌耶和華；讚美他的話必常在我口中。"
    },
    {
      "id": "psa-35-1",
      "chapter": 35,
      "verse": 1,
      "text": "（大衛的詩）耶和華啊，與我相爭的，求你與他們相爭！與我相戰的，求你與他們相戰！"
    },
    {
      "id": "psa-36-1",
      "chapter": 36,
      "verse": 1,
      "text": "（耶和華的僕人大衛的詩，交與伶長）惡人的罪過在他心裏說：我眼中不怕神！"
    },
    {
      "id": "psa-37-1",
      "chapter": 37,
      "verse": 1,
      "text": "（大衛的詩）不要為作惡的心懷不平，也不要向那行不義的生出嫉妒。"
    },
    {
      "id": "psa-38-1",
      "chapter": 38,
      "verse": 1,
      "text": "（大衛的記念詩）耶和華啊，求你不要在怒中責備我，不要在烈怒中懲罰我！"
    },
    {
      "id": "psa-39-1",
      "chapter": 39,
      "verse": 1,
      "text": "（大衛的詩，交與伶長耶杜頓）我曾說：我要謹慎我的言行，免得我舌頭犯罪；惡人在我面前的時候，我要用嚼環勒住我的口。"
    },
    {
      "id": "psa-40-1",
      "chapter": 40,
      "verse": 1,
      "text": "（大衛的詩，交與伶長）我曾耐性等候耶和華；他垂聽我的呼求。"
    },
    {
      "id": "psa-41-1",
      "chapter": 41,
      "verse": 1,
      "text": "（大衛的詩，交與伶長）眷顧貧窮的有福了！他遭難的日子，耶和華必搭救他。"
    },
    {
      "id": "psa-42-1",
      "chapter": 42,
      "verse": 1,
      "text": "（可拉後裔的訓誨詩，交與伶長）神啊，我的心切慕你，如鹿切慕溪水。"
    },
    {
      "id": "psa-43-1",
      "chapter": 43,
      "verse": 1,
      "text": "神啊，求你伸我的冤，向不虔誠的國為我辨屈；求你救我脫離詭詐不義的人。"
    },
    {
      "id": "psa-44-1",
      "chapter": 44,
      "verse": 1,
      "text": "（可拉後裔的訓誨詩，交與伶長）神啊，你在古時，我們列祖的日子所行的事，我們親耳聽見了；我們的列祖也給我們述說過。"
    },
    {
      "id": "psa-45-1",
      "chapter": 45,
      "verse": 1,
      "text": "（可拉後裔的訓誨詩，又是愛慕歌，交與伶長。調用百合花）我心裏湧出美辭；我論到我為王作的事，我的舌頭是快手筆。"
    },
    {
      "id": "psa-46-1",
      "chapter": 46,
      "verse": 1,
      "text": "（可拉後裔的詩歌，交與伶長。調用女音）神是我們的避難所，是我們的力量，是我們在患難中隨時的幫助。"
    },
    {
      "id": "psa-47-1",
      "chapter": 47,
      "verse": 1,
      "text": "（可拉後裔的詩，交與伶長）萬民哪，你們都要拍掌！要用誇勝的聲音向神呼喊！"
    },
    {
      "id": "psa-48-1",
      "chapter": 48,
      "verse": 1,
      "text": "（可拉後裔的詩歌）耶和華本為大！在我們神的城中，在他的聖山上，該受大讚美。"
    },
    {
      "id": "psa-49-1",
      "chapter": 49,
      "verse": 1,
      "text": "（可拉後裔的詩，交與伶長）萬民哪，你們都當聽這話！世上一切的居民，"
    },
    {
      "id": "psa-50-1",
      "chapter": 50,
      "verse": 1,
      "text": "（亞薩的詩）大能者神耶和華已經發言招呼天下，從日出之地到日落之處。"
    },
    {
      "id": "psa-51-1",
      "chapter": 51,
      "verse": 1,
      "text": "（大衛與拔示巴同室以後，先知拿單來見他。他作這詩，交與伶長）神啊，求你按你的慈愛憐恤我！按你豐盛的慈悲塗抹我的過犯！"
    },
    {
      "id": "psa-52-1",
      "chapter": 52,
      "verse": 1,
      "text": "（以東人多益來告訴掃羅說：「大衛到了亞希米勒家。」那時，大衛作這訓誨詩，交與伶長）勇士啊，你為何以作惡自誇？神的慈愛是常存的。"
    },
    {
      "id": "psa-53-1",
      "chapter": 53,
      "verse": 1,
      "text": "（大衛的訓誨詩，交與伶長。調用麻哈拉）愚頑人心裏說：沒有神。他們都是邪惡，行了可憎惡的罪孽；沒有一個人行善。"
    },
    {
      "id": "psa-54-1",
      "chapter": 54,
      "verse": 1,
      "text": "（西弗人來對掃羅說：「大衛豈不是在我們那裏藏身麼？」那時，大衛作這訓誨詩，交與伶長。用絲絃的樂器）神啊，求你以你的名救我，憑你的大能為我伸冤。"
    },
    {
      "id": "psa-55-1",
      "chapter": 55,
      "verse": 1,
      "text": "（大衛的訓誨詩，交與伶長。用絲絃的樂器）神啊，求你留心聽我的禱告，不要隱藏不聽我的懇求！"
    },
    {
      "id": "psa-56-1",
      "chapter": 56,
      "verse": 1,
      "text": "（非利士人在迦特拿住大衛，那時，他作這金詩，交與伶長。調用遠方無聲鴿）神啊，求你憐憫我，因為人要把我吞了，終日攻擊欺壓我。"
    },
    {
      "id": "psa-57-1",
      "chapter": 57,
      "verse": 1,
      "text": "（大衛逃避掃羅，藏在洞裏。那時，他作這金詩，交與伶長。調用休要毀壞）神啊，求你憐憫我，憐憫我！因為我的心投靠你。我要投靠在你翅膀的蔭下，等到災害過去。"
    },
    {
      "id": "psa-58-1",
      "chapter": 58,
      "verse": 1,
      "text": "（大衛的金詩，交與伶長。調用休要毀壞）世人哪，你們默然不語，真合公義麼？施行審判，豈按正直麼？"
    },
    {
      "id": "psa-59-1",
      "chapter": 59,
      "verse": 1,
      "text": "（掃羅打發人窺探大衛的房屋，要殺他。那時，大衛作這金詩，交與伶長。調用休要毀壞）我的神啊，求你救我脫離仇敵，把我安置在高處，得脫那些起來攻擊我的人。"
    },
    {
      "id": "psa-60-1",
      "chapter": 60,
      "verse": 1,
      "text": "（大衛與兩河間的亞蘭並瑣巴的亞蘭爭戰的時候，約押轉回，在鹽谷攻擊以東，殺了一萬二千人。那時，大衛作這金詩叫人學習，交與伶長。調用為證的百合花）神啊，你丟棄了我們，使我們破敗；你向我們發怒，求你使我們復興！"
    },
    {
      "id": "psa-61-1",
      "chapter": 61,
      "verse": 1,
      "text": "（大衛的詩，交與伶長。用絲絃的樂器）神阿，求你聽我的呼求，側耳聽我的禱告！"
    },
    {
      "id": "psa-62-1",
      "chapter": 62,
      "verse": 1,
      "text": "（大衛的詩，照耶杜頓的作法，交與伶長）我的心默默無聲，專等候神；我的救恩是從他而來。"
    },
    {
      "id": "psa-63-1",
      "chapter": 63,
      "verse": 1,
      "text": "（大衛在猶大曠野的時候，作了這詩）神阿，你是我的神，我要切切的尋求你，在乾旱疲乏無水之地，我渴想你；我的心切慕你。"
    },
    {
      "id": "psa-64-1",
      "chapter": 64,
      "verse": 1,
      "text": "（大衛的詩，交與伶長）神阿，我哀歎的時候，求你聽我的聲音！求你保護我的性命，不受仇敵的驚恐！"
    },
    {
      "id": "psa-65-1",
      "chapter": 65,
      "verse": 1,
      "text": "（大衛的詩歌，交與伶長）神啊，錫安的人都等候讚美你；所許的願也要向你償還。"
    },
    {
      "id": "psa-66-1",
      "chapter": 66,
      "verse": 1,
      "text": "（一篇詩歌，交與伶長）全地都當向神歡呼！"
    },
    {
      "id": "psa-67-1",
      "chapter": 67,
      "verse": 1,
      "text": "（一篇詩歌，交與伶長。用絲絃的樂器）願神憐憫我們，賜福與我們，用臉光照我們，（細拉）"
    },
    {
      "id": "psa-68-1",
      "chapter": 68,
      "verse": 1,
      "text": "（大衛的詩歌，交與伶長）願神興起，使他的仇敵四散，叫那恨他的人從他面前逃跑。"
    },
    {
      "id": "psa-69-1",
      "chapter": 69,
      "verse": 1,
      "text": "（大衛的詩，交與伶長。調用百合花）神啊，求你救我！因為眾水要淹沒我。"
    },
    {
      "id": "psa-70-1",
      "chapter": 70,
      "verse": 1,
      "text": "（大衛的記念詩，交與伶長）神啊，求你快快搭救我！耶和華啊，求你速速幫助我！"
    },
    {
      "id": "psa-71-1",
      "chapter": 71,
      "verse": 1,
      "text": "耶和華啊，我投靠你；求你叫我永不羞愧！"
    },
    {
      "id": "psa-72-1",
      "chapter": 72,
      "verse": 1,
      "text": "（所羅門的詩）神阿，求你將判斷的權柄賜給王，將公義賜給王的兒子。"
    },
    {
      "id": "psa-73-1",
      "chapter": 73,
      "verse": 1,
      "text": "（亞薩的詩）神實在恩待以色列那些清心的人！"
    },
    {
      "id": "psa-74-1",
      "chapter": 74,
      "verse": 1,
      "text": "（亞薩的訓誨詩）神啊，你為何永遠丟棄我們呢？你為何向你草場的羊發怒，如煙冒出呢？"
    },
    {
      "id": "psa-75-1",
      "chapter": 75,
      "verse": 1,
      "text": "（亞薩的詩歌，交與伶長。調用休要毀壞）神啊，我們稱謝你，我們稱謝你！因為你的名相近，人都述說你奇妙的作為。"
    },
    {
      "id": "psa-76-1",
      "chapter": 76,
      "verse": 1,
      "text": "（亞薩的詩歌，交與伶長。用絲絃的樂器）在猶大，神為人所認識；在以色列，他的名為大。"
    },
    {
      "id": "psa-77-1",
      "chapter": 77,
      "verse": 1,
      "text": "（亞薩的詩，照耶杜頓的作法，交與伶長）我要向神發聲呼求；我向神發聲，他必留心聽我。"
    },
    {
      "id": "psa-78-1",
      "chapter": 78,
      "verse": 1,
      "text": "（亞薩的訓誨詩）我的民哪，你們要留心聽我的訓誨，側耳聽我口中的話。"
    },
    {
      "id": "psa-79-1",
      "chapter": 79,
      "verse": 1,
      "text": "（亞薩的詩）神啊，外邦人進入你的產業，污穢你的聖殿，使耶路撒冷變成荒堆，"
    },
    {
      "id": "psa-80-1",
      "chapter": 80,
      "verse": 1,
      "text": "（亞薩的詩，交與伶長。調用為證的百合花）領約瑟如領羊群之以色列的牧者阿，求你留心聽！坐在二基路伯上的阿，求你發出光來！"
    },
    {
      "id": "psa-81-1",
      "chapter": 81,
      "verse": 1,
      "text": "（亞薩的詩，交與伶長。用迦特樂器）你們當向神我們的力量大聲歡呼，向雅各的神發聲歡樂！"
    },
    {
      "id": "psa-82-1",
      "chapter": 82,
      "verse": 1,
      "text": "（亞薩的詩）神站在有權力者的會中，在諸神中行審判，"
    },
    {
      "id": "psa-83-1",
      "chapter": 83,
      "verse": 1,
      "text": "（亞薩的詩歌）神啊，求你不要靜默！神啊，求你不要閉口，也不要不作聲！"
    },
    {
      "id": "psa-84-1",
      "chapter": 84,
      "verse": 1,
      "text": "（可拉後裔的詩，交與伶長。用迦特樂器）萬軍之耶和華啊，你的居所何等可愛！"
    },
    {
      "id": "psa-85-1",
      "chapter": 85,
      "verse": 1,
      "text": "（可拉後裔的詩，交與伶長）耶和華啊，你已經向你的地施恩，救回被擄的雅各。"
    },
    {
      "id": "psa-86-1",
      "chapter": 86,
      "verse": 1,
      "text": "（大衛的祈禱）耶和華啊，求你側耳應允我，因我是困苦窮乏的。"
    },
    {
      "id": "psa-87-1",
      "chapter": 87,
      "verse": 1,
      "text": "（可拉後裔的詩歌）耶和華所立的根基在聖山上。"
    },
    {
      "id": "psa-88-1",
      "chapter": 88,
      "verse": 1,
      "text": "（可拉後裔的詩歌，就是以斯拉人希幔的訓誨詩，交與伶長。調用麻哈拉利暗俄）耶和華拯救我的神啊，我晝夜在你面前呼籲。"
    },
    {
      "id": "psa-89-1",
      "chapter": 89,
      "verse": 1,
      "text": "（以斯拉人以探的訓誨詩）我要歌唱耶和華的慈愛，直到永遠；我要用口將你的信實傳與萬代。"
    },
    {
      "id": "psa-90-1",
      "chapter": 90,
      "verse": 1,
      "text": "（神人摩西的祈禱）主阿，你世世代代作我們的居所。"
    },
    {
      "id": "psa-91-1",
      "chapter": 91,
      "verse": 1,
      "text": "住在至高者隱密處的，必住在全能者的蔭下。"
    },
    {
      "id": "psa-92-1",
      "chapter": 92,
      "verse": 1,
      "text": "（安息日的詩歌）稱謝耶和華！歌頌你至高者的名！"
    },
    {
      "id": "psa-93-1",
      "chapter": 93,
      "verse": 1,
      "text": "耶和華作王！他以威嚴為衣穿上；耶和華以能力為衣，以能力束腰，世界就堅定，不得動搖。"
    },
    {
      "id": "psa-94-1",
      "chapter": 94,
      "verse": 1,
      "text": "耶和華啊，你是伸冤的神；伸冤的神啊，求你發出光來！"
    },
    {
      "id": "psa-95-1",
      "chapter": 95,
      "verse": 1,
      "text": "來阿，我們要向耶和華歌唱，向拯救我們的磐石歡呼！"
    },
    {
      "id": "psa-96-1",
      "chapter": 96,
      "verse": 1,
      "text": "你們要向耶和華唱新歌！全地都要向耶和華歌唱！"
    },
    {
      "id": "psa-97-1",
      "chapter": 97,
      "verse": 1,
      "text": "耶和華作王！願地快樂！願眾海島歡喜！"
    },
    {
      "id": "psa-98-1",
      "chapter": 98,
      "verse": 1,
      "text": "（一篇詩）你們要向耶和華唱新歌！因為他行過奇妙的事；他的右手和聖臂施行救恩。"
    },
    {
      "id": "psa-99-1",
      "chapter": 99,
      "verse": 1,
      "text": "耶和華作王；萬民當戰抖！他坐在二基路伯上，地當動搖。"
    },
    {
      "id": "psa-100-1",
      "chapter": 100,
      "verse": 1,
      "text": "（稱謝詩）普天下當向耶和華歡呼！"
    },
    {
      "id": "psa-101-1",
      "chapter": 101,
      "verse": 1,
      "text": "（大衛的詩）我要歌唱慈愛和公平；耶和華阿，我要向你歌頌！"
    },
    {
      "id": "psa-102-1",
      "chapter": 102,
      "verse": 1,
      "text": "（困苦人發昏的時候，在耶和華面前吐露苦情的禱告）耶和華啊，求你聽我的禱告，容我的呼求達到你面前！"
    },
    {
      "id": "psa-103-1",
      "chapter": 103,
      "verse": 1,
      "text": "（大衛的詩）我的心哪，你要稱頌耶和華！凡在我裏面的，也要稱頌他的聖名！"
    },
    {
      "id": "psa-104-1",
      "chapter": 104,
      "verse": 1,
      "text": "我的心哪，你要稱頌耶和華！耶和華我的神阿，你為至大！你以尊榮威嚴為衣服，"
    },
    {
      "id": "psa-105-1",
      "chapter": 105,
      "verse": 1,
      "text": "你們要稱謝耶和華，求告他的名，在萬民中傳揚他的作為！"
    },
    {
      "id": "psa-106-1",
      "chapter": 106,
      "verse": 1,
      "text": "你們要讚美耶和華！要稱謝耶和華，因他本為善；他的慈愛永遠長存！"
    },
    {
      "id": "psa-107-1",
      "chapter": 107,
      "verse": 1,
      "text": "你們要稱謝耶和華，因他本為善；他的慈愛永遠長存！"
    },
    {
      "id": "psa-108-1",
      "chapter": 108,
      "verse": 1,
      "text": "（大衛的詩歌）神啊，我心堅定；我口〔原文作榮耀〕要唱詩歌頌！"
    },
    {
      "id": "psa-109-1",
      "chapter": 109,
      "verse": 1,
      "text": "（大衛的詩，交與伶長）我所讚美的神啊，求你不要閉口不言。"
    },
    {
      "id": "psa-110-1",
      "chapter": 110,
      "verse": 1,
      "text": "（大衛的詩）耶和華對我主說：你坐在我的右邊，等我使你仇敵作你的腳凳。"
    },
    {
      "id": "psa-111-1",
      "chapter": 111,
      "verse": 1,
      "text": "你們要讚美耶和華！我要在正直人的大會中，並公會中，一心稱謝耶和華。"
    },
    {
      "id": "psa-112-1",
      "chapter": 112,
      "verse": 1,
      "text": "你們要讚美耶和華！敬畏耶和華，甚喜愛他命令的，這人便為有福！"
    },
    {
      "id": "psa-113-1",
      "chapter": 113,
      "verse": 1,
      "text": "你們要讚美耶和華！耶和華的僕人哪，你們要讚美，讚美耶和華的名！"
    },
    {
      "id": "psa-114-1",
      "chapter": 114,
      "verse": 1,
      "text": "以色列出了埃及，雅各家離開說異言之民；"
    },
    {
      "id": "psa-115-1",
      "chapter": 115,
      "verse": 1,
      "text": "耶和華啊，榮耀不要歸與我們，不要歸與我們；要因你的慈愛和誠實歸在你的名下！"
    },
    {
      "id": "psa-116-1",
      "chapter": 116,
      "verse": 1,
      "text": "我愛耶和華，因為他聽了我的聲音和我的懇求。"
    },
    {
      "id": "psa-117-1",
      "chapter": 117,
      "verse": 1,
      "text": "萬國啊，你們都當讚美耶和華！萬民哪，你們都當頌讚他！"
    },
    {
      "id": "psa-118-1",
      "chapter": 118,
      "verse": 1,
      "text": "你們要稱謝耶和華，因他本為善；他的慈愛永遠長存！"
    },
    {
      "id": "psa-119-1",
      "chapter": 119,
      "verse": 1,
      "text": "行為完全、遵行耶和華律法的，這人便為有福！"
    },
    {
      "id": "psa-120-1",
      "chapter": 120,
      "verse": 1,
      "text": "（上行〔或作登階。下同〕之詩）我在急難中求告耶和華，他就應允我。"
    },
    {
      "id": "psa-121-1",
      "chapter": 121,
      "verse": 1,
      "text": "（上行之詩）我要向山舉目；我的幫助從何而來？"
    },
    {
      "id": "psa-122-1",
      "chapter": 122,
      "verse": 1,
      "text": "（大衛上行之詩）人對我說：我們往耶和華的殿去，我就歡喜。"
    },
    {
      "id": "psa-123-1",
      "chapter": 123,
      "verse": 1,
      "text": "（上行之詩）坐在天上的主啊，我向你舉目。"
    },
    {
      "id": "psa-124-1",
      "chapter": 124,
      "verse": 1,
      "text": "（大衛上行之詩）以色列人要說：若不是耶和華幫助我們，"
    },
    {
      "id": "psa-125-1",
      "chapter": 125,
      "verse": 1,
      "text": "（上行之詩）倚靠耶和華的人好像錫安山，永不動搖。"
    },
    {
      "id": "psa-126-1",
      "chapter": 126,
      "verse": 1,
      "text": "（上行之詩）當耶和華將那些被擄的帶回錫安的時候，我們好像作夢的人。"
    },
    {
      "id": "psa-127-1",
      "chapter": 127,
      "verse": 1,
      "text": "（所羅門上行之詩）若不是耶和華建造房屋，建造的人就枉然勞力；若不是耶和華看守城池，看守的人就枉然儆醒。"
    },
    {
      "id": "psa-128-1",
      "chapter": 128,
      "verse": 1,
      "text": "（上行之詩）凡敬畏耶和華、遵行他道的人便為有福！"
    },
    {
      "id": "psa-129-1",
      "chapter": 129,
      "verse": 1,
      "text": "（上行之詩）以色列當說：從我幼年以來，敵人屢次苦害我，"
    },
    {
      "id": "psa-130-1",
      "chapter": 130,
      "verse": 1,
      "text": "（上行之詩）耶和華啊，我從深處向你求告！"
    },
    {
      "id": "psa-131-1",
      "chapter": 131,
      "verse": 1,
      "text": "（大衛上行之詩）耶和華啊，我的心不狂傲，我的眼不高大；重大和測不透的事，我也不敢行。"
    },
    {
      "id": "psa-132-1",
      "chapter": 132,
      "verse": 1,
      "text": "（上行之詩）耶和華啊，求你記念大衛所受的一切苦難！"
    },
    {
      "id": "psa-133-1",
      "chapter": 133,
      "verse": 1,
      "text": "（大衛上行之詩）看哪，弟兄和睦同居，是何等的善，何等的美！"
    },
    {
      "id": "psa-134-1",
      "chapter": 134,
      "verse": 1,
      "text": "（上行之詩）耶和華的僕人夜間站在耶和華殿中的，你們當稱頌耶和華！"
    },
    {
      "id": "psa-135-1",
      "chapter": 135,
      "verse": 1,
      "text": "你們要讚美耶和華！你們要讚美耶和華的名！耶和華的僕人站在耶和華殿中；站在我們神殿院中的，你們要讚美他！"
    },
    {
      "id": "psa-136-1",
      "chapter": 136,
      "verse": 1,
      "text": "你們要稱謝耶和華，因他本為善；他的慈愛永遠長存。"
    },
    {
      "id": "psa-137-1",
      "chapter": 137,
      "verse": 1,
      "text": "我們曾在巴比倫的河邊坐下，一追想錫安就哭了。"
    },
    {
      "id": "psa-138-1",
      "chapter": 138,
      "verse": 1,
      "text": "（大衛之詩）我要一心稱謝你，在諸神面前歌頌你。"
    },
    {
      "id": "psa-139-1",
      "chapter": 139,
      "verse": 1,
      "text": "（大衛的詩，交與伶長）耶和華啊，你已經鑒察我，認識我。"
    },
    {
      "id": "psa-140-1",
      "chapter": 140,
      "verse": 1,
      "text": "（大衛的詩，交與伶長）耶和華阿，求你拯救我脫離兇惡的人，保護我脫離強暴的人！"
    },
    {
      "id": "psa-141-1",
      "chapter": 141,
      "verse": 1,
      "text": "（大衛的詩）耶和華啊，我曾求告你，求你快快臨到我這裏！我求告你的時候，願你留心聽我的聲音！"
    },
    {
      "id": "psa-142-1",
      "chapter": 142,
      "verse": 1,
      "text": "（大衛在洞裏作的訓誨詩，乃是祈禱）我發聲哀告耶和華，發聲懇求耶和華。"
    },
    {
      "id": "psa-143-1",
      "chapter": 143,
      "verse": 1,
      "text": "（大衛的詩）耶和華啊，求你聽我的禱告，留心聽我的懇求，憑你的信實和公義應允我。"
    },
    {
      "id": "psa-144-1",
      "chapter": 144,
      "verse": 1,
      "text": "（大衛的詩）耶和華我的磐石是應當稱頌的！他教導我的手爭戰，教導我的指頭打仗。"
    },
    {
      "id": "psa-145-1",
      "chapter": 145,
      "verse": 1,
      "text": "（大衛的讚美詩）我的神我的王阿，我要尊崇你！我要永永遠遠稱頌你的名！"
    },
    {
      "id": "psa-146-1",
      "chapter": 146,
      "verse": 1,
      "text": "你們要讚美耶和華！我的心哪，你要讚美耶和華！"
    },
    {
      "id": "psa-147-1",
      "chapter": 147,
      "verse": 1,
      "text": "你們要讚美耶和華！因歌頌我們的神為善為美；讚美的話是合宜的。"
    },
    {
      "id": "psa-148-1",
      "chapter": 148,
      "verse": 1,
      "text": "你們要讚美耶和華！從天上讚美耶和華，在高處讚美他！"
    },
    {
      "id": "psa-149-1",
      "chapter": 149,
      "verse": 1,
      "text": "你們要讚美耶和華！向耶和華唱新歌，在聖民的會中讚美他！"
    },
    {
      "id": "psa-150-1",
      "chapter": 150,
      "verse": 1,
      "text": "你們要讚美耶和華！在神的聖所讚美他！在他顯能力的穹蒼讚美他！"
    }
  ]
}