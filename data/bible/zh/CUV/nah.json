{
  "book": "那鴻書",
  "book_id": "nah",
  "testament": "OT",
  "language": "zh",
  "version": "CUV",
  "verses": [
    {
      "id": "nah-1-1",
      "chapter": 1,
      "verse": 1,
      "text": "論尼尼微的默示，就是伊勒歌斯人那鴻所得的默示。"
    },
    {
      "id": "nah-2-1",
      "chapter": 2,
      "verse": 1,
      "text": "尼尼微啊，那打碎邦國的上來攻擊你。你要看守保障，謹防道路，使腰強壯，大大勉力。"
    },
    {
      "id": "nah-3-1",
      "chapter": 3,
      "verse": 1,
      "text": "禍哉！這流人血的城，充滿謊詐和強暴，搶奪的事總不止息。"
    }
  ]
}